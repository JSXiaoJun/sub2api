# =============================================================================
# Sub2API blue-green: optional overrides
# =============================================================================
# These are NOT read from this file automatically. They are plain environment
# variables for bluegreen.sh — export them in the shell (or put them in front of
# the command) when the detected defaults are wrong:
#
#   BG_EDGE_PORT=8081 ./bluegreen.sh init
#
# Everything the script detects during `init` is persisted to .runtime/state.env
# and reused by later commands, so you usually only set these once.
# =============================================================================

# Path to the .env of your existing single-container deployment.
# Default: the deploy directory that contains this bluegreen/ folder.
# BG_ENV_FILE=/opt/sub2api/.env

# Image used when no --image is given to `deploy`.
# BG_IMAGE_DEFAULT=weishaw/sub2api:latest

# How long to wait for a new slot to answer /health before giving up.
# Migrations on a large database run before the listener starts, so keep this
# generous. Default: 1800 (30 minutes).
# BG_HEALTH_TIMEOUT=1800

# Docker network that already connects the app to postgres/redis.
# Default: detected from the running sub2api container, e.g. "deploy_sub2api-network".
# BG_NETWORK=deploy_sub2api-network

# CIDRs the application should trust for X-Forwarded-* parsing. The script
# defaults this to the subnet of BG_NETWORK (the edge container lives there).
# Set it explicitly if you also run a CDN or another proxy in front of the edge.
# BG_TRUSTED_PROXIES=172.18.0.0/16

# Public entry port. The edge takes over the port your single container used,
# so keep this equal to the old SERVER_PORT/host port. Default: 8080.
# BG_EDGE_BIND_IP=0.0.0.0
# BG_EDGE_PORT=8080

# Loopback-only debugging ports for the two slots. Default: 18080 / 18081.
# BG_BIND_IP=127.0.0.1
# BG_BLUE_PORT=18080
# BG_GREEN_PORT=18081

# Edge image. Default: caddy:2-alpine
# BG_EDGE_IMAGE=caddy:2-alpine
