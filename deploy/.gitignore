# =============================================================================
# Sub2API Deploy Directory - Git Ignore
# =============================================================================

# Data directories (generated at runtime when using docker-compose.local.yml)
data/
postgres_data/
redis_data/

# Environment configuration (contains sensitive information)
.env

# Backup files
*.backup
*.bak

# Temporary files
*.tmp
*.log

# Blue-green runtime state (generated by bluegreen/bluegreen.sh init):
# detected network/data mount, active slot, image tags, active upstream.
bluegreen/.runtime/
